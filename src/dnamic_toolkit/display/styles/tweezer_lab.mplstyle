# Interactive/lab style for quick analysis figures.
axes.prop_cycle : cycler('color', ['4477AA', 'EE6677', '228833', 'CCBB44', '66CCEE', 'AA3377', 'BBBBBB'])

figure.figsize : 7, 5
figure.dpi : 180

font.family : sans-serif
font.sans-serif : Nimbus Sans L, DejaVu Sans, Arial, Helvetica, sans-serif
font.size : 8
mathtext.fontset : dejavusans
text.usetex : False

axes.labelsize : 8
axes.linewidth : 0.75
axes.formatter.use_mathtext : True
axes.formatter.useoffset : False

xtick.direction : in
xtick.major.size : 3
xtick.major.width : 0.75
xtick.minor.size : 1.5
xtick.minor.width : 0.75
xtick.minor.visible : True
xtick.top : True
xtick.labelsize : 8

ytick.direction : in
ytick.major.size : 3
ytick.major.width : 0.75
ytick.minor.size : 1.5
ytick.minor.width : 0.75
ytick.minor.visible : True
ytick.right : True
ytick.labelsize : 8

legend.frameon : False
legend.fontsize : 8

grid.linewidth : 0.75
lines.linewidth : 2
lines.markersize : 7
errorbar.capsize : 0
svg.fonttype : none
